# Custom Kernel Enhancements for Lenovo TB373FU / MT6897 (Dimensity 8300)
# Base: Linux 6.1.182 Android Common Kernel (ACK android14-6.1)
# Compatible with OneUI 9 Port (KMI-safe, vendor_boot/vendor_dlkm untouched)

# ==========================================
# 1. KERNEL-LEVEL ROOT & ROOT HIDING (SuSFS)
# ==========================================
CONFIG_KSU=y
CONFIG_KSU_SUSFS=y
CONFIG_KSU_SUSFS_SUS_PATH=y
CONFIG_KSU_SUSFS_SUS_MOUNT=y
CONFIG_KSU_SUSFS_AUTO_ADD_SUS_KSU_DEFAULT_MOUNT=y
CONFIG_KSU_SUSFS_AUTO_ADD_SUS_BIND_MOUNT=y
CONFIG_KSU_SUSFS_SUS_KSTAT=y
CONFIG_KSU_SUSFS_SUS_OVERLAYFS=y
CONFIG_KSU_SUSFS_TRY_UMOUNT=y
CONFIG_KSU_SUSFS_SPOOF_UNAME=y
CONFIG_KSU_SUSFS_ENABLE_LOG=n
CONFIG_KSU_SUSFS_HIDE_KSU_SUSFS_SYMBOLS=y
CONFIG_KSU_SUSFS_SPOOF_CMDLINE_OR_BOOTCONFIG=y
CONFIG_KPROBES=y
CONFIG_HAVE_KPROBES=y

# ==========================================
# 2. MEMORY & ONEUI 9 MULTITASKING (MGLRU)
# ==========================================
CONFIG_LRU_GEN=y
CONFIG_LRU_GEN_ENABLED=y
# CONFIG_LRU_GEN_STATS is not set
CONFIG_ZRAM=m
CONFIG_ZRAM_DEF_COMP_ZSTD=y
CONFIG_ZRAM_DEF_COMP="zstd"
CONFIG_ZRAM_WRITEBACK=y
CONFIG_OVERLAY_FS=y
CONFIG_OVERLAY_FS_REDIRECT_ALWAYS_FOLLOW=y

# ==========================================
# 3. PERFORMANCE & TOUCH LATENCY (144Hz)
# ==========================================
CONFIG_HZ_300=y
CONFIG_HZ=300
CONFIG_SCHED_WALT=y
CONFIG_UCLAMP_TASK=y
CONFIG_UCLAMP_TASK_GROUP=y

# ==========================================
# 4. WI-FI & NETWORKING (BBR + WIREGUARD)
# ==========================================
CONFIG_TCP_CONG_BBR=y
CONFIG_DEFAULT_TCP_CONG="bbr"
CONFIG_NET_SCH_FQ=y
CONFIG_NET_SCH_FQ_CODEL=y
CONFIG_WIREGUARD=y

# ==========================================
# 5. USB & TOOLING CAPABILITIES
# ==========================================
CONFIG_USB_CONFIGFS_F_FS=y
CONFIG_USB_CONFIGFS_MASS_STORAGE=y
